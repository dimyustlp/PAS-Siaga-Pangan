# Salin file ini menjadi .env.local (untuk komputer sendiri) atau isi di Vercel > Settings > Environment Variables.
# Kedua nilai ada di Supabase: Project Settings > API Keys / Data API.
# Keduanya memang boleh terlihat di browser. JANGAN pernah memasukkan service_role key atau password database di sini.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
